local function BuildToggle(feature, order)
    local state = feature.default
    local row = New("Frame", {
        LayoutOrder = order,
        Size = UDim2.new(1, -6, 0, 70),
        BackgroundColor3 = THEME.Row,
        BorderSizePixel = 0,
    }, { Corner(12), Stroke(THEME.Stroke, 1) })

    New("TextLabel", {
        Text = feature.name,
        Font = Enum.Font.GothamBold,
        TextSize = 15,
        TextColor3 = THEME.Text,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(16, 10),
        Size = UDim2.new(0.6, 0, 0, 20),
        TextXAlignment = Enum.TextXAlignment.Left,
    }).Parent = row

    New("TextLabel", {
        Text = feature.desc,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = THEME.SubText,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(16, 32),
        Size = UDim2.new(0.6, 0, 0, 16),
        TextXAlignment = Enum.TextXAlignment.Left,
    }).Parent = row

    local statePill = New("TextButton", {
        Text = state and "ENABLED" or "DISABLED",
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = state and THEME.Knob or THEME.Text,
        BackgroundColor3 = state and THEME.On or THEME.Off,
        AutoButtonColor = false,
        Size = UDim2.fromOffset(120, 32),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -16, 0.5, 0),
    }, { Corner(16), Stroke(THEME.Stroke, 1) })
    statePill.Parent = row

    local function render(anim)
        local t = anim and 0.2 or 0
        Tween(statePill, t, { BackgroundColor3 = state and THEME.On or THEME.Off })
        statePill.Text = state and "ENABLED" or "DISABLED"
        Tween(statePill, t, { TextColor3 = state and THEME.Knob or THEME.Text })
    end

    OnClick(statePill, function()
        state = not state
        render(true)
        Settings:Set(feature.id, state)
    end)

    render(false)
    row.Parent = list

    Settings:Connect(feature.id, function(v)
        if v ~= state then state = v; render(true) end
    end)
end

for i, f in ipairs(FEATURES) do BuildToggle(f, i) end

