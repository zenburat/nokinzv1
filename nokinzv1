--------------------------------------------------------------------
-- LOS CHECK
--------------------------------------------------------------------
local function HasLOS(origin, target)
    if not Settings:Get("WallCheck") then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local myChar = player.Character
    if myChar then params.FilterDescendantsInstances = { myChar } end
    local res = Workspace:Raycast(origin, (target - origin) * 0.99, params)
    if not res then return true end
    return Players:GetPlayerFromCharacter(res.Instance.Parent) ~= nil
end

--------------------------------------------------------------------
-- GET CLOSEST TARGET
--------------------------------------------------------------------
local function GetClosest(excludeP)
    local best, bestDist = nil, math.huge
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p == player or p == excludeP then continue end
        if Settings:Get("TeamCheck") and p.Team == player.Team and p.Team ~= nil then continue end
        local char = p.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local bone = char and char:FindFirstChild(aimBone)
        if not char or not hum or not bone or hum.Health <= 0 then continue end
        if Settings:Get("WallCheck") and not HasLOS(camera.CFrame.Position, bone.Position) then continue end
        local scr, on = camera:WorldToViewportPoint(bone.Position)
        if not on then continue end
        local dist = (Vector2.new(scr.X, scr.Y) - center).Magnitude
        if dist < fovRadius and dist < bestDist then
            bestDist = dist; best = p
        end
    end
    return best
end

--------------------------------------------------------------------
-- AIMBOT
--------------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    if not Settings:Get("Aimbot") then return end

    -- PC: hold RMB.  Mobile: always active while enabled.
    local shouldAim = false
    if isMobile then
        shouldAim = true
    else
        shouldAim = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    end
    if not shouldAim then return end

    local target = GetClosest()
    if not target then return end
    local char = target.Character
    local bone = char and char:FindFirstChild(aimBone)
    if not bone then return end

    local scr = camera:WorldToViewportPoint(bone.Position)
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    local delta = Vector2.new(scr.X, scr.Y) - center

    local vpSize = camera.ViewportSize
    local fovRad = math.rad(camera.FieldOfView)
    local yAngle = math.atan2(delta.X, vpSize.X / (2 * math.tan(fovRad / 2)))
    local xAngle = math.atan2(delta.Y, vpSize.Y / (2 * math.tan(fovRad / 2)))

    camera.CFrame = camera.CFrame:Lerp(
        camera.CFrame * CFrame.Angles(-xAngle, -yAngle, 0),
        aimbotSmooth
    )
end)

--------------------------------------------------------------------
-- SILENT AIM
--------------------------------------------------------------------
local silentTarget = nil
local silentDiedConn = nil

local function AttachDiedWatcher(p)
    if silentDiedConn then silentDiedConn:Disconnect() end
    local char = p.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    silentDiedConn = hum.Died:Connect(function()
        task.wait(0.2)
        silentTarget = GetClosest(p)
    end)
end

Settings:Connect("SilentAim", function(on)
    if on then
        silentTarget = GetClosest()
        if silentTarget then AttachDiedWatcher(silentTarget) end
    else
        silentTarget = nil
        if silentDiedConn then silentDiedConn:Disconnect() end
    end
end)

RunService.RenderStepped:Connect(function()
    if not Settings:Get("SilentAim") then return end
    if not silentTarget then
        silentTarget = GetClosest()
        if silentTarget then AttachDiedWatcher(silentTarget) end
        return
    end
    local char = silentTarget.Character
    local head = char and char:FindFirstChild("Head")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not head or not hum or hum.Health <= 0 then return end
    local targetCF = CFrame.new(camera.CFrame.Position, head.Position)
    camera.CFrame = camera.CFrame:Lerp(targetCF, 0.28)
end)

--------------------------------------------------------------------
-- MAGIC BULLET
--------------------------------------------------------------------
local magicBulletEnabled = false
local magicHookedTools = {}
local magicHookedRemotes = {}

local function GetMagicTargets()
    local t = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then continue end
        if Settings:Get("TeamCheck") and p.Team == player.Team and p.Team ~= nil then continue end
        local char = p.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if char and hum and hum.Health > 0 then table.insert(t, hum) end
    end
    return t
end

local function FireMagicShot()
    if not magicBulletEnabled then return end
    for _, hum in ipairs(GetMagicTargets()) do
        pcall(function() hum:TakeDamage(20) end)
    end
end

local function HookTool(tool)
    if not tool:IsA("Tool") or magicHookedTools[tool] then return end
    magicHookedTools[tool] = true
    tool.Activated:Connect(function()
        if not magicBulletEnabled then return end
        task.wait(0.03); FireMagicShot()
    end)
end

local function HookCharacter(char)
    for _, d in ipairs(char:GetDescendants()) do if d:IsA("Tool") then HookTool(d) end end
    char.DescendantAdded:Connect(function(d) if d:IsA("Tool") then HookTool(d) end end)
end

local function HookRemote(obj)
    if magicHookedRemotes[obj] or not obj:IsA("RemoteEvent") then return end
    local n = obj.Name:lower()
    if not (n:find("hit") or n:find("shoot") or n:find("fire")
          or n:find("damage") or n:find("attack") or n:find("bullet")) then return end
    magicHookedRemotes[obj] = true
    obj.OnClientEvent:Connect(function()
        if not magicBulletEnabled then return end
        task.wait(0.02); FireMagicShot()
    end)
end

local function InstallMagicHooks()
    if player.Character then HookCharacter(player.Character) end
    player.CharacterAdded:Connect(HookCharacter)
    for _, cont in ipairs({ ReplicatedStorage, Workspace }) do
        for _, d in ipairs(cont:GetDescendants()) do HookRemote(d) end
        cont.DescendantAdded:Connect(HookRemote)
    end
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or not magicBulletEnabled then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        task.wait(0.03); FireMagicShot()
    end
end)

Settings:Connect("MagicBullet", function(on)
    magicBulletEnabled = on
    if on then InstallMagicHooks() end
end)
